{
  "name": "CE Vault — USDT Arbitrage Dashboard",
  "install": "npm ci && { [ -f .env.local ] || cp .env.local.example .env.local; }",
  "start": "bash scripts/cloud-supabase-up.sh",
  "terminals": [
    {
      "name": "next-dev",
      "command": "npm run dev",
      "description": "Next.js dev server (dashboard + API + Telegram webhook) on http://localhost:3000"
    }
  ],
  "ports": [
    {
      "name": "web",
      "port": 3000
    },
    {
      "name": "supabase-api",
      "port": 54321
    }
  ]
}
