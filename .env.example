# ============================================================
# CE VAULT — environment template (.env.example)
# Copy to .env.local and fill in real values. NEVER commit real secrets.
# Only the variables the code actually reads are listed here.
# ============================================================

# ===== Supabase =====
# Public (inlined into the client bundle at build time)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
# New-style publishable key (optional alias for the anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
# Server-only. Prefer the new secret key (sb_secret_...); service role key works as a legacy fallback.
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key
# SUPABASE_SERVICE_ROLE_KEY=replace-with-legacy-service-role-key
# Optional server-side aliases used by src/lib/supabaseServer.ts
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
# SUPABASE_JWKS_URL=
# Storage bucket for uploaded slips
SUPABASE_BUCKET=slips

# ===== API security (write endpoints + cron) =====
# Generate with: openssl rand -hex 32
API_SECRET=replace-with-64-hex-api-secret
# Allow write APIs without a key in LOCAL dev only (never in production)
ALLOW_INSECURE_DEV_API=0

# ===== Dashboard PIN gate =====
# 6-digit PIN for /dashboard
DASHBOARD_PIN=000000
# HMAC session signing secret (>= 32 chars). Falls back to API_SECRET if unset.
# Generate with: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=replace-with-64-hex-session-secret

# ===== Telegram bot =====
BOT_TOKEN=replace-with-botfather-token
# 16–256 chars [A-Za-z0-9_-]; must differ from API_SECRET
TELEGRAM_WEBHOOK_SECRET=replace-with-independent-webhook-secret
# Comma-separated Telegram user IDs allowed to bootstrap as admin
ADMIN_TELEGRAM_IDS=123456789
# HTTPS origin, no path/query (used to register the webhook)
APP_URL=https://your-project.example
# Group/channel chat_id for notifications (empty = disabled)
NOTIFY_CHAT_ID=

# ===== Rates & account defaults =====
DEFAULT_SELL_RATE=35.5
DEFAULT_MARKET_RATE=34.8
DEFAULT_BANK_ACCOUNT_ID=
FEE_WARNING_THRESHOLD=3

# ===== OCR / Vision (configure at least one provider) =====
GROK_API_KEY=
# XAI_API_KEY=            # alias accepted for GROK_API_KEY
GROK_MODEL=grok-4.20-non-reasoning
OCR_SPACE_API_KEY=
# Critical rule: never below 90
OCR_AUTO_MIN=90

# ===== AI chat providers (optional, used by /api/ai/chat-completion) =====
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# ===== Telegram sticker file_ids (optional) =====
STICKER_WELCOME_ID=
STICKER_PROCESSING_ID=
STICKER_OCR_DONE_ID=
STICKER_WAITING_ID=
STICKER_SUCCESS_ID=
STICKER_ERROR_ID=
STICKER_RETRY_ID=
STICKER_THANKYOU_ID=
STICKER_VIP_ID=
STICKER_QUEUE_ID=

# ===== Circle Smart Contract Platform (optional) =====
CIRCLE_API_KEY=
ENTITY_SECRET=
# CIRCLE_SCP_BLOCKCHAIN=ARC-TESTNET
