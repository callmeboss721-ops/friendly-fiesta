{
  "name": "ce-vault",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "ts-node --project test/tsconfig.json test/run-test.ts && ts-node --project test/tsconfig.json test/desk-ops.test.ts && ts-node --project test/tsconfig.json test/fifty-rounds.ts && ts-node --project test/tsconfig.json test/reconciliation.test.ts && node scripts/validate-bank-assets.mjs && node scripts/build-tokens.mjs --check",
    "validate:banks": "node scripts/validate-bank-assets.mjs",
    "tokens:build": "node scripts/build-tokens.mjs",
    "validate:env": "node -r ts-node/register scripts/validate-env.ts",
    "migrate:help": "echo \"Uses STAGING_DATABASE_URL environment variable. Example: STAGING_DATABASE_URL='******host:5432/db' npm run migrate:staging-node\"",
    "migrate:staging": "psql \"$STAGING_DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/patch-v10-production-safety.sql",
    "migrate:staging-node": "node scripts/run-migration.js",
    "composio:smoke": "node scripts/composio-smoke.mjs",
    "composio:connect": "COMPOSIO_CONNECT=1 node scripts/composio-smoke.mjs",
    "composio:oauth": "node scripts/composio-oauth-debug.mjs",
    "migrate:cycles": "MIGRATION_FILE=db/migrations/20260913_ce_vault_cycles.sql node scripts/run-migration.js"
  },
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "^10.8.0",
    "@circle-fin/smart-contract-platform": "^10.8.0",
    "@composio/core": "^0.17.0",
    "@jest/globals": "^30.4.1",
    "@supabase/server": "^1.4.1",
    "@supabase/supabase-js": "^2.45.4",
    "axios": "^1.19.0",
    "decimal.js": "10.6.0",
    "drizzle-orm": "^1.0.0-beta.22",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "next": "^15.3.3",
    "pg": "^8.22.0",
    "promptparse": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "slipverify": "^0.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^20.16.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^1.0.0-beta.22",
    "jest": "^30.4.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
